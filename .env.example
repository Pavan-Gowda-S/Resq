# ==============================================================================
# RESQ SYSTEM ENVIRONMENT CONFIGURATION (EXAMPLE)
# Copy this file to .env and configure local secrets. Never commit .env!
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=True
APP_NAME="RESQ Emergency Coordination Platform"
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Backend Server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# PostgreSQL Database (with PostGIS)
POSTGRES_USER=resq_user
POSTGRES_PASSWORD=resq_password
POSTGRES_DB=resq_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://resq_user:resq_password@localhost:5432/resq_db
DATABASE_SYNC_URL=postgresql://resq_user:resq_password@localhost:5432/resq_db

# Redis (Caching, Rate Limiting & Real-time PubSub)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# AI Agents & Google Gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=

# Agent Backend API Connection
BACKEND_API_BASE_URL=http://localhost:8000/api/v1
AGENT_SYSTEM_API_KEY=resq_agent_internal_secret_token

# Simulation & Mapping Configuration
SIMULATION_MODE=true
DEFAULT_GEO_CRS=EPSG:4326
KERALA_DEFAULT_LAT=10.8505
KERALA_DEFAULT_LNG=76.2711

# Offline Sync & Security
OFFLINE_SYNC_WINDOW_HOURS=72
MAX_RESERVATION_TIMEOUT_MINUTES=30
