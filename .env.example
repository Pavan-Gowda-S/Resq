# ==============================================================================
# RESQ DISASTER PLATFORM - SAFE ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and supply cryptographically generated secrets before running.

# ------------------------------------------------------------------------------
# ENVIRONMENT & RUNTIME
# ------------------------------------------------------------------------------
ENVIRONMENT=development
DEBUG=False
TESTING=0

# ------------------------------------------------------------------------------
# DATABASE CREDENTIALS (POSTGRESQL 16 + POSTGIS)
# ------------------------------------------------------------------------------
POSTGRES_USER=resq_user
POSTGRES_PASSWORD=replace_with_strong_database_password
POSTGRES_DB=resq_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://resq_user:replace_with_strong_database_password@localhost:5432/resq_db
DATABASE_SYNC_URL=postgresql://resq_user:replace_with_strong_database_password@localhost:5432/resq_db

# ------------------------------------------------------------------------------
# REDIS (PUBSUB, CACHE, RATE LIMITING)
# ------------------------------------------------------------------------------
REDIS_PORT=6379
REDIS_PASSWORD=replace_with_strong_redis_password
REDIS_URL=redis://:replace_with_strong_redis_password@localhost:6379/0

# ------------------------------------------------------------------------------
# AUTHENTICATION & CRYPTOGRAPHY (CRITICAL SECRETS)
# ------------------------------------------------------------------------------
# Generate with: openssl rand -hex 32
SECRET_KEY=replace_with_64_character_hex_jwt_secret_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Application-level AES-256-GCM Master Encryption Key (32 bytes = 64 hex characters)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
RESQ_MASTER_ENCRYPTION_KEY=replace_with_64_character_hex_encryption_key

# ------------------------------------------------------------------------------
# AGENT SYSTEM INTERNAL API KEY
# ------------------------------------------------------------------------------
# Used for autonomous AI agent system operations on live backend
AGENT_SYSTEM_API_KEY=replace_with_strong_internal_agent_api_token
USE_MOCK_BACKEND=False
BACKEND_API_BASE_URL=http://localhost:8000/api/v1

# ------------------------------------------------------------------------------
# CORS & FRONTEND CLIENT ORIGINS
# ------------------------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://resq.gov.in
